{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "Meter-Kanäle",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "EX-1280: Slot 1 = Out 1-4 | Slot 2 = Out 5-8 | Slot 3 = In 1-4 | Slot 4 = In 5-8"
                },
                {
                    "type": "List",
                    "name": "MeterChannels",
                    "caption": "",
                    "rowCount": 8,
                    "add": true,
                    "delete": true,
                    "sort": {
                        "column": "Position",
                        "direction": "ascending"
                    },
                    "columns": [
                        {
                            "name": "Position",
                            "caption": "Pos",
                            "width": "50px",
                            "add": 1,
                            "edit": {
                                "type": "NumberSpinner",
                                "minimum": 1,
                                "maximum": 32
                            }
                        },
                        {
                            "name": "Slot",
                            "caption": "Slot",
                            "width": "60px",
                            "add": 1,
                            "edit": {
                                "type": "NumberSpinner",
                                "minimum": 1,
                                "maximum": 8
                            }
                        },
                        {
                            "name": "Channel",
                            "caption": "Kanal",
                            "width": "60px",
                            "add": 1,
                            "edit": {
                                "type": "NumberSpinner",
                                "minimum": 1,
                                "maximum": 8
                            }
                        },
                        {
                            "name": "Label",
                            "caption": "Anzeige-Label",
                            "width": "auto",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "name": "Threshold",
                            "caption": "Schwelle (dB)",
                            "width": "100px",
                            "add": -50,
                            "edit": {
                                "type": "NumberSpinner",
                                "minimum": -60,
                                "maximum": 0
                            }
                        }
                    ],
                    "values": []
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Darstellung",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "YellowThreshold",
                    "caption": "Gelb ab (dB)",
                    "minimum": -60,
                    "maximum": 0,
                    "suffix": " dB"
                },
                {
                    "type": "NumberSpinner",
                    "name": "RedThreshold",
                    "caption": "Rot ab (dB)",
                    "minimum": -60,
                    "maximum": 0,
                    "suffix": " dB"
                },
                {
                    "type": "NumberSpinner",
                    "name": "MeterHeight",
                    "caption": "Meter-Höhe (px)",
                    "minimum": 100,
                    "maximum": 400,
                    "suffix": " px"
                },
                {
                    "type": "NumberSpinner",
                    "name": "BarWidth",
                    "caption": "Balkenbreite (px)",
                    "minimum": 8,
                    "maximum": 80,
                    "suffix": " px"
                },
                {
                    "type": "SelectColor",
                    "name": "BackgroundColor",
                    "caption": "Hintergrundfarbe"
                },
                {
                    "type": "NumberSpinner",
                    "name": "BackgroundOpacity",
                    "caption": "Deckkraft",
                    "minimum": 0,
                    "maximum": 100,
                    "suffix": " %"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Meter jetzt aktualisieren",
            "onClick": "BOSE_UpdateMeterHTML($id);"
        }
    ],
    "status": []
}
